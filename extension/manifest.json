{
  "manifest_version": 3,
  "name": "TearAway",
  "version": "1.0.0",
  "description": "Tear live UI out of any webpage into a floating widget.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "clipboardRead"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TearAway — hold Alt to pick"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/tearaway2.js"],
      "css": ["content/tearaway.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["lib/html2canvas.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}