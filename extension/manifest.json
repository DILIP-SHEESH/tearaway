{
  "manifest_version": 3,
  "name": "TearAway",
  "version": "0.2.0",
  "description": "Hold Alt, tear any live element off the page into a floating always-on-top widget.",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TearAway"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/tearaway2.js"],
      "css": ["content/tearaway.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["demo/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
